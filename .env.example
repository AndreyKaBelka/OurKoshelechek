POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ourkoshelechek
POSTGRES_PORT=5432
PORT=8080
# Secret used to sign access tokens (HS256). Required in any non-dev
# environment; falls back to an insecure default if unset.
JWT_SECRET=change-me

FRONTEND_PORT=3000
# GraphQL endpoint baked into the frontend build. The default "/query" relies
# on nginx (frontend/nginx.conf) proxying same-origin requests to the app
# service, so it normally doesn't need to change for docker-compose.
FRONTEND_API_URL=/query
