POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ourkoshelechek
POSTGRES_PORT=5432
PORT=8081
# Secret used to sign access tokens (HS256). Required in any non-dev
# environment; falls back to an insecure default if unset.
JWT_SECRET=change-me

FRONTEND_PORT=3000
# GraphQL endpoint baked into the frontend build. The default "/query" relies
# on nginx (frontend/nginx.conf) proxying same-origin requests to the app
# service, so it normally doesn't need to change for docker-compose.
FRONTEND_API_URL=/query

# Postgres backups (see the "backup" service in docker-compose.yml). Dumps
# land in ./backups on the host, one file per day/week/month, pruned by the
# BACKUP_KEEP_* settings. SCHEDULE uses the postgres-backup-local cron format
# (https://github.com/prodrigestivill/docker-postgres-backup-local).
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=2
BACKUP_KEEP_MONTHS=2
